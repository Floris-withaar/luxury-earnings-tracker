# Copy to .env or export in your shell. Needed only for the three LLM steps.
# Never commit a real key. On GitHub the key lives in a repository secret of the same name.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: research on claude-haiku-5-5, extract and interpret on claude-sonnet-5-5.
TRACKER_MODEL_RESEARCH=
TRACKER_MODEL_EXTRACT=
TRACKER_MODEL_INTERPRET=
